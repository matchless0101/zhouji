# 示例，不含真实密码。生产配置置于服务器 /etc/zhouji/api.env，权限 600。
# 由服务管理器加载；应用不自动搜索或加载其他项目的 .env。
ZHOUJI_DB_HOST=127.0.0.1
ZHOUJI_DB_PORT=3306
ZHOUJI_DB_NAME=zhouji
ZHOUJI_DB_USER=zhouji_app
ZHOUJI_DB_PASSWORD=

# 真实 AppID 仅填写在未跟踪的本地或服务器配置中，不得写入示例或文档。
ZHOUJI_WECHAT_APP_ID=
# AppSecret 仅保存为服务器权限 600 的文件；不在客户端或 Git 中保存。
ZHOUJI_WECHAT_APP_SECRET_PATH=

# Apple 登录：实际标识和私钥只写私有配置，五项须同时配置。
ZHOUJI_APPLE_TEAM_ID=
ZHOUJI_APPLE_CLIENT_ID=
ZHOUJI_APPLE_KEY_ID=
ZHOUJI_APPLE_PRIVATE_KEY_PATH=
ZHOUJI_TOKEN_ENCRYPTION_KEY_PATH=
# 生产路径由 systemd LoadCredential 映射到 /run/credentials/zhouji-api.service/。
